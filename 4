import java.io.BufferedReader;
import java.io.BufferedWriter;
import java.io.FileReader;
import java.io.FileWriter;
import java.io.File;
import java.io.IOException;
import java.util.Locale;
import java.util.Scanner;
import java.util.List;

public class Main {

    public static void createFileIfNotExists(String filename, String content) {
        File file = new File(filename);
        if (file.exists()) {
            return;
        }

        try (BufferedWriter writer = new BufferedWriter(new FileWriter(file))) {
            writer.write(content);
        } catch (IOException e) {
            System.err.println("Error creating file " + filename + ": " + e.getMessage());
        }
    }

    public static void createSampleFiles() {
        createFileIfNotExists("sample1.csv", "ID,Name,Age\n1,John,30\n2,Jane,25\n3,Bob,40\n");
        createFileIfNotExists("sample2.csv", "Code,Description,Price\nA001,Product A,9.99\nB002,Product B,14.99\nC003,Product C,19.99\n");
        createFileIfNotExists("sample3.csv", "Country,Capital,Population\nUSA,Washington D.C.,328.2\nJapan,Tokyo,126.5\nFrance,Paris,66.99\n");
    }

    public static void main(String[] args) {
        createSampleFiles();
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter the CSV file name/path: ");
        String filename = sc.nextLine().trim();

        System.out.print("Enter the column to average (by header name): ");
        String columnName = sc.nextLine().trim();

        System.out.print("Enter the output format (integer or float): ");
        String outputformat = sc.nextLine().trim();

        try (BufferedReader fileReader = new BufferedReader(new FileReader(filename))) {
            String line = fileReader.readLine();
            if (line == null) return;

            String[] headers = line.split(",");
            int columnIndex = -1;
            for (int i = 0; i < headers.length; i++) {
                if (headers[i].trim().equalsIgnoreCase(columnName)) {
                    columnIndex = i;
                    break;
                }
            }

            if (columnIndex == -1) {
                System.out.println("Error: Column " + columnName + " not found");
                return;
            }

            double total = 0.0;
            int rowCount = 0;

            while ((line = fileReader.readLine()) != null) {
                if (line.trim().isEmpty()) continue;
                String[] values = line.split(",");
                if (columnIndex < values.length) {
                    try {
                        total += Double.parseDouble(values[columnIndex].trim());
                        rowCount++;
                    } catch (NumberFormatException e) {

                    }
                }
            }

            if (rowCount == 0) {
                System.out.println("Error: No data found to calculate average");
                return;
            }

            double avg = total / rowCount;

            if (outputformat.equalsIgnoreCase("integer")) {
                System.out.println("Average " + columnName + ": " + (int) avg);
            } else {
                if (avg % 1 == 0) {
                    System.out.println("Average " + columnName + ": " + (int) avg);
                } else {
                    System.out.println("Average " + columnName + ": " + String.format(Locale.US, "%.2f", avg));
                }
            }

        } catch (IOException e) {
            System.err.println("Error reading file: " + e.getMessage());
        } finally {
            sc.close();
        }
    }
}